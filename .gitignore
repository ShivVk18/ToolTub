# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
public/vendor/
public/models/*.onnx
worker/node_modules
tests/fixtures/generated/
playwright-report/
test-results/
.lighthouseci/
!.env.example

# generated test/visual output (re-created by scripts; never commit)
reports/ui/**/*.png
reports/ui/**/*.jpg
reports/ui/**/*.webm
*.log

# local editor / agent settings
.vscode/
.idea/
.claude/settings.local.json

# PDF fixtures are generated by tests/fixtures/generate.mjs (into generated/)
tests/fixtures/*.pdf
