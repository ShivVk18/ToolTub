# Copy to .env for docker compose. Every variable the code reads is listed here.

# Public site URL used in canonical URLs, sitemaps, JSON-LD and llms.txt.
NEXT_PUBLIC_SITE_URL=https://klipkit.com

# Queue (Valkey/Redis) and the shared folder for server-tool files.
VALKEY_URL=redis://valkey:6379
JOBS_DIR=/data/jobs

# Rate limiting for server tools: salt for hashing IPs (required), jobs per IP per hour.
RATE_LIMIT_SALT=generate-a-long-random-string
RATE_LIMIT_MAX=20

# Worker (LibreOffice). RETENTION_MS = when uploaded and converted files are deleted (default 1 hour).
CONCURRENCY=1
RETENTION_MS=3600000
SWEEP_INTERVAL_MS=300000
HEARTBEAT_MS=5000

# Umami analytics (self-hosted).
UMAMI_DB_PASSWORD=generate-a-password
UMAMI_SECRET=generate-a-secret

# IndexNow (scripts/indexnow.mjs, run from your server after deploys).
INDEXNOW_KEY=
SITE_HOST=klipkit.com
